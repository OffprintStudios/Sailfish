		"@tailwindcss/forms": "^0.5.7",
		"@tailwindcss/typography": "^0.5.14",
		"@types/eslint": "^8.56.11",
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^20.16.1",
		"@types/slug": "^5.0.9",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.9.1",

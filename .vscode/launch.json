    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Cargo Test Lib",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=sailfish"
                ],
                "filter": {
                    "name": "sailfish",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Cargo Build",
            "cargo": {
                "args": [
                    "build",
                    "--bin=sailfish",
                    "--package=sailfish"
                ],
                "filter": {
                    "name": "sailfish",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Cargo Test",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=sailfish",
                    "--package=sailfish"
                ],
                "filter": {
                    "name": "sailfish",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Leptos Watch",
            "cargo": {
                "args": [
                    "leptos",
                    "watch"
                ]
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Leptos Build",
            "cargo": {
                "args": [
                    "leptos",
                    "build"
                ]
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Leptos Serve",
            "cargo": {
                "args": [
                    "leptos",
                    "serve"
                ]
            }
        }
    ]
}